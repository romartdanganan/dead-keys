[ext_resource type="PackedScene" path="res://scenes/ui/upgrade_row.tscn" id="3_row"]

[node name="UpgradeShop" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
