[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/upgrade_shop.gd" id="1_shop"]
[ext_resource type="Texture2D" path="res://icon.svg" id="2_icon"]
[ext_resource type="PackedScene" path="res://scenes/ui/upgrade_row.tscn" id="3_row"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_topbar_normal"]
bg_color = Color(0.58, 0.4, 0.24, 1)
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 3
border_color = Color(0.32, 0.2, 0.11, 1)
corner_radius_top_left = 10
corner_radius_top_right = 10
corner_radius_bottom_right = 10
corner_radius_bottom_left = 10

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_topbar_hover"]
bg_color = Color(0.65, 0.46, 0.28, 1)
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 3
border_color = Color(0.32, 0.2, 0.11, 1)
corner_radius_top_left = 10
corner_radius_top_right = 10
corner_radius_bottom_right = 10
corner_radius_bottom_left = 10

[node name="UpgradeShop" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_shop")

[node name="BackgroundColor" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.307571, 0.494309, 0.348993, 1)

[node name="MainMargin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 20

[node name="MainLayout" type="VBoxContainer" parent="MainMargin"]
layout_mode = 2
theme_override_constants/separation = 15

[node name="TopBar" type="HBoxContainer" parent="MainMargin/MainLayout"]
custom_minimum_size = Vector2(0, 65)
layout_mode = 2

[node name="TitleLabel" type="Label" parent="MainMargin/MainLayout/TopBar"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 1
theme_override_font_sizes/font_size = 30
text = "UPGRADES"
vertical_alignment = 1

[node name="GoldPanel" type="PanelContainer" parent="MainMargin/MainLayout/TopBar"]
custom_minimum_size = Vector2(180, 60)
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_topbar_normal")

[node name="GoldMargin" type="MarginContainer" parent="MainMargin/MainLayout/TopBar/GoldPanel"]
layout_mode = 2
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 14
theme_override_constants/margin_bottom = 8

[node name="GoldContent" type="HBoxContainer" parent="MainMargin/MainLayout/TopBar/GoldPanel/GoldMargin"]
layout_mode = 2
theme_override_constants/separation = 8
alignment = 1

[node name="GoldIcon" type="TextureRect" parent="MainMargin/MainLayout/TopBar/GoldPanel/GoldMargin/GoldContent"]
custom_minimum_size = Vector2(36, 36)
layout_mode = 2
mouse_filter = 2
texture = ExtResource("2_icon")
expand_mode = 1
stretch_mode = 5

[node name="GoldLabel" type="Label" parent="MainMargin/MainLayout/TopBar/GoldPanel/GoldMargin/GoldContent"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
text = "GOLD: 0"

[node name="BackButton" type="Button" parent="MainMargin/MainLayout/TopBar"]
custom_minimum_size = Vector2(130, 60)
layout_mode = 2
theme_override_styles/normal = SubResource("StyleBoxFlat_topbar_normal")
theme_override_styles/hover = SubResource("StyleBoxFlat_topbar_hover")
theme_override_colors/font_color = Color(1, 1, 1, 1)
text = "BACK"

[node name="RowsScroll" type="ScrollContainer" parent="MainMargin/MainLayout"]
layout_mode = 2
size_flags_vertical = 3

[node name="RowsContainer" type="VBoxContainer" parent="MainMargin/MainLayout/RowsScroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="WeaponSectionLabel" type="Label" parent="MainMargin/MainLayout/RowsScroll/RowsContainer"]
