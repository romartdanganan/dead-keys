vertical_alignment = 1

[node name="Content2" type="Label" parent="CenterContainer/MenuPanel/MenuMargin/MenuList/MenuPanel2/ScrollContainer/VBoxContainer" unique_id=686522578]
layout_mode = 2
theme_override_colors/font_color = Color(0.9490196, 0.9019608, 0.8, 0.7490196)
theme_override_font_sizes/font_size = 20
text = "Use your mouse to aim. Press %s to Fire. You must aim and shoot the zombies.
"
vertical_alignment = 1

[node name="WatchMistakes" type="Label" parent="CenterContainer/MenuPanel/MenuMargin/MenuList/MenuPanel2/ScrollContainer/VBoxContainer" unique_id=1622320111]
layout_mode = 2
theme_override_colors/font_color = Color(0.9490196, 0.9019608, 0.8, 1)
theme_override_font_sizes/font_size = 26
text = "WATCH YOUR MISTAKES"
vertical_alignment = 1

[node name="Content3" type="Label" parent="CenterContainer/MenuPanel/MenuMargin/MenuList/MenuPanel2/ScrollContainer/VBoxContainer" unique_id=1894881981]
layout_mode = 2
theme_override_colors/font_color = Color(0.9490196, 0.9019608, 0.8, 0.7490196)
theme_override_font_sizes/font_size = 20
text = "Making a typing mistake costs 1 bullet. Three mistakes in a row will jam your weapon for 2 seconds.
Your Combo resets when you make a mistake or when a zombie reaches the wall. (Typing mistakes
can be turned off under the Gameplay tab in Settings).
"
vertical_alignment = 1

[node name="UseSupplies" type="Label" parent="CenterContainer/MenuPanel/MenuMargin/MenuList/MenuPanel2/ScrollContainer/VBoxContainer" unique_id=31176912]
layout_mode = 2
theme_override_colors/font_color = Color(0.9490196, 0.9019608, 0.8, 1)
theme_override_font_sizes/font_size = 26
text = "USE SUPPLIES"
vertical_alignment = 1

[node name="Content4" type="Label" parent="CenterContainer/MenuPanel/MenuMargin/MenuList/MenuPanel2/ScrollContainer/VBoxContainer" unique_id=1948827862]
layout_mode = 2
theme_override_colors/font_color = Color(0.9490196, 0.9019608, 0.8, 0.7490196)
theme_override_font_sizes/font_size = 20
text = "You can bring up to 3 supplies into a mission. Press %s, %s or %s to call the corresponding supply. After
the crate lands, type its word before the timer runs out to activate it.
"
vertical_alignment = 1
autowrap_mode = 2

[node name="UseAbility" type="Label" parent="CenterContainer/MenuPanel/MenuMargin/MenuList/MenuPanel2/ScrollContainer/VBoxContainer" unique_id=541266752]
layout_mode = 2
theme_override_colors/font_color = Color(0.9490196, 0.9019608, 0.8, 1)
theme_override_font_sizes/font_size = 26
text = "USE YOUR ABILITY"
vertical_alignment = 1

[node name="Content5" type="Label" parent="CenterContainer/MenuPanel/MenuMargin/MenuList/MenuPanel2/ScrollContainer/VBoxContainer" unique_id=28361672]
layout_mode = 2
theme_override_colors/font_color = Color(0.9490196, 0.9019608, 0.8, 0.7490196)
theme_override_font_sizes/font_size = 20
text = "Get 5 kills in a row without making a mistake to charge your ability. Your ability activates 
automatically on your next shot.
"
vertical_alignment = 1

[node name="ProtectWall" type="Label" parent="CenterContainer/MenuPanel/MenuMargin/MenuList/MenuPanel2/ScrollContainer/VBoxContainer" unique_id=636235906]
layout_mode = 2
theme_override_colors/font_color = Color(0.9490196, 0.9019608, 0.8, 1)
theme_override_font_sizes/font_size = 26
text = "PROTECT THE WALL"
vertical_alignment = 1

[node name="Content6" type="Label" parent="CenterContainer/MenuPanel/MenuMargin/MenuList/MenuPanel2/ScrollContainer/VBoxContainer" unique_id=2086409659]
layout_mode = 2
theme_override_colors/font_color = Color(0.9490196, 0.9019608, 0.8, 0.7490196)
theme_override_font_sizes/font_size = 20
text = "Don't let the zombies reach the wall.
If the wall loses all its health, you lose a life.
Survive the mission and earn coins to buy upgrades and supplies.
"
vertical_alignment = 1

