[node name="Content" type="Label" parent="CenterContainer/MenuPanel/MenuMargin/MenuList/MenuPanel2/ScrollContainer/VBoxContainer" unique_id=116507054]
layout_mode = 2
theme_override_colors/font_color = Color(0.9490196, 0.9019608, 0.8, 0.7490196)
