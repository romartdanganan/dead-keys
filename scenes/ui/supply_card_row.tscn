[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/supply_card_row.gd" id="1_card"]
[ext_resource type="Texture2D" path="res://icon.svg" id="2_icon"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_buy_normal"]
bg_color = Color(0.42, 0.62, 0.3, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.24, 0.42, 0.16, 1)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_buy_hover"]
bg_color = Color(0.49, 0.7, 0.36, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.24, 0.42, 0.16, 1)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_buy_disabled"]
bg_color = Color(0.42, 0.62, 0.3, 0.4)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.24, 0.42, 0.16, 0.4)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8

[node name="SupplyCardRow" type="PanelContainer"]
custom_minimum_size = Vector2(230, 200)
layout_mode = 2
script = ExtResource("1_card")
supply_id = ""

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 14
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 14
theme_override_constants/margin_bottom = 12

[node name="Content" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 8
alignment = 1

[node name="Icon" type="TextureRect" parent="Margin/Content"]
custom_minimum_size = Vector2(64, 64)
layout_mode = 2
size_flags_horizontal = 4
mouse_filter = 2
texture = ExtResource("2_icon")
expand_mode = 1
stretch_mode = 5

[node name="NameLabel" type="Label" parent="Margin/Content"]
layout_mode = 2
text = "SUPPLY NAME"
horizontal_alignment = 1
autowrap_mode = 3

[node name="CostLabel" type="Label" parent="Margin/Content"]
layout_mode = 2
text = "0 GOLD"
horizontal_alignment = 1

[node name="BuyButton" type="Button" parent="Margin/Content"]
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
theme_override_styles/normal = SubResource("StyleBoxFlat_buy_normal")
theme_override_styles/hover = SubResource("StyleBoxFlat_buy_hover")
theme_override_styles/pressed = SubResource("StyleBoxFlat_buy_normal")
theme_override_styles/disabled = SubResource("StyleBoxFlat_buy_disabled")
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/font_disabled_color = Color(1, 1, 1, 0.5)
text = "BUY"

[connection signal="pressed" from="Margin/Content/BuyButton" to="." method="_on_buy_pressed"]
