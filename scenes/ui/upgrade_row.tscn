[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/upgrade_row.gd" id="1_row"]

[node name="UpgradeRow" type="PanelContainer"]
custom_minimum_size = Vector2(0, 56)
layout_mode = 2
script = ExtResource("1_row")
track_id = ""

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 14
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 14
theme_override_constants/margin_bottom = 8

[node name="Content" type="HBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="NameLabel" type="Label" parent="Margin/Content"]
custom_minimum_size = Vector2(190, 0)
layout_mode = 2
text = "UPGRADE NAME"
vertical_alignment = 1

[node name="LevelLabel" type="Label" parent="Margin/Content"]
custom_minimum_size = Vector2(100, 0)
layout_mode = 2
text = "LEVEL 0 / 0"
vertical_alignment = 1

[node name="ValueLabel" type="Label" parent="Margin/Content"]
layout_mode = 2
size_flags_horizontal = 3
text = "CURRENT: -"
vertical_alignment = 1

[node name="CostLabel" type="Label" parent="Margin/Content"]
custom_minimum_size = Vector2(140, 0)
layout_mode = 2
text = "COST: -"
horizontal_alignment = 2
vertical_alignment = 1

[node name="BuyButton" type="Button" parent="Margin/Content"]
custom_minimum_size = Vector2(110, 40)
layout_mode = 2
text = "UPGRADE"

[connection signal="pressed" from="Margin/Content/BuyButton" to="." method="_on_buy_button_pressed"]
